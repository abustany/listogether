{
  "name": "listogether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check-staged": "./scripts/check-format.js",
    "check": "oxlint src && oxfmt --check src",
    "dev": "vite",
    "icons": "./scripts/make-icons.js && oxfmt --write src/icons && oxlint --fix src/icons",
    "format": "oxfmt --write src scripts vite.config.ts",
    "lint": "oxlint src",
    "prepare": "cd .. && husky install ui/.husky",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/uuid": "9.0.1",
    "feather-icons": "^4.29.0",
    "husky": "8.0.3",
    "vite": "8.0.0",
    "vite-plugin-pwa": "1.2.0",
    "vite-plugin-solid": "2.11.11",
    "vite-plugin-wasm": "3.5.0",
    "workbox-build": "7.4.0",
    "workbox-precaching": "7.4.0",
    "workbox-window": "7.4.0"
  },
  "dependencies": {
    "@automerge/automerge": "2.0.2",
    "@sentry/browser": "7.45.0",
    "@solid-primitives/event-listener": "2.4.5",
    "@solidjs/router": "0.15.4",
    "base64-js": "^1.5.1",
    "date-fns": "^2.29.3",
    "idb": "^7.1.1",
    "solid-js": "1.9.11",
    "solid-transition-group": "0.2.2",
    "uuid": "^9.0.0"
  }
}
