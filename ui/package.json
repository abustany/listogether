{
  "name": "listogether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check-staged": "./scripts/check-format.js",
    "check": "rome ci src",
    "dev": "vite",
    "icons": "./scripts/make-icons.js && rome format --write src/icons && rome check --apply-suggested src/icons",
    "format": "rome format --write src cypress cypress.config.ts scripts vite.config.ts",
    "lint": "rome check src",
    "prepare": "cd .. && husky install ui/.husky",
    "preview": "vite preview",
    "test": "vitest"
  },
  "devDependencies": {
    "@testing-library/cypress": "^9.0.0",
    "@this-dot/cypress-indexeddb": "^2.0.1",
    "@types/uuid": "9.0.1",
    "cypress": "12.9.0",
    "feather-icons": "^4.29.0",
    "husky": "8.0.3",
    "jsdom": "21.1.1",
    "rome": "12.0.0",
    "typescript": "5.0.2",
    "vite": "4.2.1",
    "vite-plugin-pwa": "0.14.7",
    "vite-plugin-solid": "2.6.1",
    "vite-plugin-wasm": "3.2.2",
    "vitest": "0.29.8",
    "workbox-build": "^6.5.4",
    "workbox-precaching": "^6.5.4",
    "workbox-window": "^6.5.4"
  },
  "dependencies": {
    "@automerge/automerge": "2.0.2",
    "@sentry/browser": "7.45.0",
    "@solid-primitives/event-listener": "2.2.9",
    "@solidjs/router": "0.8.2",
    "base64-js": "^1.5.1",
    "date-fns": "^2.29.3",
    "idb": "^7.1.1",
    "solid-js": "1.6.16",
    "solid-transition-group": "0.2.2",
    "uuid": "^9.0.0"
  }
}
