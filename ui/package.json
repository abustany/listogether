{
  "name": "listogether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check-staged": "./scripts/check-format.js",
    "check": "rome ci src",
    "dev": "vite",
    "icons": "./scripts/make-icons.js && rome format --write src/icons && rome check --apply-suggested src/icons",
    "format": "rome format --write src cypress cypress.config.ts scripts vite.config.ts",
    "lint": "rome check src",
    "prepare": "cd .. && husky install ui/.husky",
    "preview": "vite preview",
    "test": "vitest"
  },
  "devDependencies": {
    "@testing-library/cypress": "^9.0.0",
    "@this-dot/cypress-indexeddb": "^2.0.1",
    "@types/uuid": "^9.0.0",
    "cypress": "^12.8.1",
    "feather-icons": "^4.29.0",
    "husky": "^8.0.2",
    "jsdom": "^21.0.0",
    "rome": "^11.0.0",
    "typescript": "^4.6.4",
    "vite": "^3.2.3",
    "vite-plugin-pwa": "^0.14.1",
    "vite-plugin-solid": "^2.5.0",
    "vite-plugin-wasm": "^3.1.0",
    "vitest": "^0.27.1",
    "workbox-build": "^6.5.4",
    "workbox-precaching": "^6.5.4",
    "workbox-window": "^6.5.4"
  },
  "dependencies": {
    "@automerge/automerge": "^2.0.1",
    "@sentry/browser": "^7.36.0",
    "@solid-primitives/event-listener": "^2.2.6",
    "@solidjs/router": "^0.7.0",
    "base64-js": "^1.5.1",
    "date-fns": "^2.29.3",
    "idb": "^7.1.1",
    "solid-js": "^1.6.2",
    "solid-transition-group": "^0.0.13",
    "uuid": "^9.0.0"
  }
}
